# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Banco (SQLAlchemy URL)
# Exemplo Postgres:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/meubanco
# Exemplo SQLite:
# DATABASE_URL=sqlite:///./meubanco.db
DATABASE_URL=sqlite:///./data/local.db

# Tabela e colunas para indexar no RAG
TARGET_TABLE=rag_docs
TARGET_ID_COLUMN=id
TARGET_TEXT_COLUMNS=titulo,cadastro,conteudo

# Quantidade de linhas que serao indexadas
MAX_ROWS=2000

# Quantos trechos enviar ao modelo por pergunta
TOP_K=6
